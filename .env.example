# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.

# --- Google OAuth (Google Cloud Console > Credentials) ---
GOOGLE_OAUTH_ID=your-google-oauth-client-id
GOOGLE_OAUTH_SECRET=your-google-oauth-client-secret

# --- NextAuth (v4) ---
# NEXTAUTH_URL: the app's base URL (e.g. http://localhost:3000 in dev)
# NEXTAUTH_SECRET: random string, e.g. `openssl rand -base64 32`
# NOTE: Auth.js v5 (Phase 3) renames this to AUTH_SECRET.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret

# --- Sanity (sanity.io project settings) ---
SANITY_STUDIO_SANITY_PROJECT_ID=your-sanity-project-id
SANITY_STUDIO_SANITY_DATASET=production
# Write token with create/update/delete permissions (sanity.io > API > Tokens)
SANITY_SECRET_TOKEN=your-sanity-write-token

# --- App ---
# Username (email local-part) granted admin privileges.
# WARNING: exposed to the client. Phase 3 moves admin checks server-side.
NEXT_PUBLIC_ADMIN_ID=your-admin-username
